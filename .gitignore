# === UPM Package repo layout ===

# TestProject~ Unity project caches
TestProject~/[Ll]ibrary/
TestProject~/[Tt]emp/
TestProject~/[Oo]bj/
TestProject~/[Bb]uild/
TestProject~/[Bb]uilds/
TestProject~/[Ll]ogs/
TestProject~/[Uu]ser[Ss]ettings/
TestProject~/[Mm]emoryCaptures/
TestProject~/[Rr]ecordings/
TestProject~/[Aa]ssets/[Ss]treamingAssets/

# Root-level Unity caches (from opening repo root by mistake)
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Native plugin build artifacts
native~/cef/
native~/build/
native~/*.tar.bz2

# GPUCache / DawnCache / CEF cache (runtime artifacts)
GPUCache/
DawnCache/
cef_cache/
cef.log

# Autogenerated VS/Rider solution and project files
.vs/
.gradle/
.run/
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity meta files for debug symbols
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity crash report
sysinfo.txt

# Build artifacts
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics
crashlytics-build.properties

# Packed Addressables
**/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Assets
**/[Ss]treamingAssets/aa.meta
**/[Ss]treamingAssets/aa/*

# Cursor IDE state
.cursor/
.idea/
debug.log
